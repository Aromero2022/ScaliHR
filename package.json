{
  "name": "talentgo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "dev:web": "turbo dev --filter=@talentgo/web",
    "dev:mobile": "turbo dev --filter=@talentgo/mobile",
    "db:generate": "turbo db:generate"
  },
  "devDependencies": {
    "turbo": "^2.5.0",
    "typescript": "^5.7.0"
  },
  "packageManager": "npm@10.9.4",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Aromero2022/TalentGo.git"
  }
}
