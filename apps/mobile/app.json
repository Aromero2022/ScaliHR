{
  "expo": {
    "name": "Scalia HR",
    "slug": "scaliahr-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "scaliahr",
    "platforms": ["ios", "android"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.scaliahr.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1a1a2e"
      },
      "package": "com.scaliahr.mobile"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ]
  }
}
