# ─── Supabase ────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ─── Database (Prisma) ──────────────────────────────────────────────
# DATABASE_URL uses prisma_app role (NOBYPASSRLS, subject to RLS)
DATABASE_URL=postgresql://prisma_app:your-password@db.your-project.supabase.co:5432/postgres
# DIRECT_URL uses postgres role (only for prisma db pull, never in app code)
DIRECT_URL=postgresql://postgres.your-project:your-password@aws-0-region.pooler.supabase.com:5432/postgres

# ─── Admin DB (privileged, only for lib/jobs/ and lib/admin/) ───────
ADMIN_DATABASE_URL=postgresql://postgres:your-password@db.your-project.supabase.co:5432/postgres

# ─── Auth ────────────────────────────────────────────────────────────
JWT_SECRET=super-secret-jwt-token-change-in-production
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── External Services ──────────────────────────────────────────────
ANTHROPIC_API_KEY=your-anthropic-api-key

# ─── Moodle LMS (docker-compose.lms.yml) ────────────────────────────
MOODLE_DB_PASSWORD=change-in-production
MOODLE_BASE_URL=http://localhost:8080
MOODLE_WS_TOKEN=your-moodle-ws-token
